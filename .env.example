# Copy to .env. Only settings that are used by the code are listed here.
APP_ENV=development
LOG_LEVEL=INFO

# API
DATABASE_URL=postgresql+asyncpg://ai_detector:ai_detector@localhost:5432/ai_detector
REDIS_URL=redis://localhost:6379/0
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
MAX_CAMERAS=8
UPLOAD_MAX_BYTES=2147483648
UPLOAD_ALLOWED_EXTENSIONS=.mp4,.mov,.mkv,.avi

# Shared by API and worker
# Token for the internal worker API; use a random value outside local development.
WORKER_API_TOKEN=dev-worker-token-change-me
# Uploaded videos; API writes, worker reads (same directory / volume).
UPLOAD_PATH=data/uploads

# Vision worker (REDIS_URL above is shared)
WORKER_ID=worker-local
WORKER_HTTP_HOST=127.0.0.1
WORKER_HTTP_PORT=8001
API_BASE_URL=http://127.0.0.1:8000
RECONNECT_INITIAL_DELAY_SECONDS=1
RECONNECT_MAX_DELAY_SECONDS=30

# docker compose (postgres container)
POSTGRES_USER=ai_detector
POSTGRES_PASSWORD=ai_detector
POSTGRES_DB=ai_detector
