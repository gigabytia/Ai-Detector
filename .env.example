# Copy to .env. Only settings that are used by the code are listed here.
APP_ENV=development
LOG_LEVEL=INFO

# API
DATABASE_URL=postgresql+asyncpg://ai_detector:ai_detector@127.0.0.1:15432/ai_detector
REDIS_URL=redis://127.0.0.1:6379/0
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
MAX_CAMERAS=8
UPLOAD_MAX_BYTES=2147483648
UPLOAD_ALLOWED_EXTENSIONS=.mp4,.mov,.mkv,.avi

# Shared by API and worker
# Token for the internal worker API; use a random value outside local development.
WORKER_API_TOKEN=dev-worker-token-change-me
# Uploaded videos; API writes, worker reads (same directory / volume).
UPLOAD_PATH=data/uploads

# Vision worker (REDIS_URL above is shared)
WORKER_ID=worker-local
WORKER_HTTP_HOST=127.0.0.1
WORKER_HTTP_PORT=8001
API_BASE_URL=http://127.0.0.1:8000
RECONNECT_INITIAL_DELAY_SECONDS=1
RECONNECT_MAX_DELAY_SECONDS=30

# docker compose (postgres container)
POSTGRES_USER=ai_detector
POSTGRES_PASSWORD=ai_detector
POSTGRES_DB=ai_detector

# Detection (API defaults; each camera can override these via /cameras/{id}/config)
TARGET_FPS=10
DETECTION_CONFIDENCE=0.25
# Worker: explicit, integrity-checked model; download with `uv run ai-detector-model`
MODEL_MANIFEST_PATH=models/person-detector/manifest.yaml
# Manual worker setting; start.cmd overrides this ONLY in its child processes by saved profile.
INFERENCE_DEVICE=auto
# Applied after predictor warmup (Ultralytics CPU setup otherwise resets this).
# CPU tuning is workload-dependent; benchmark before changing defaults.
INFERENCE_THREADS=2
INFERENCE_BATCH_SIZE=4
INFERENCE_MAX_WAIT_MS=20
DETECTION_IOU=0.45
PREVIEW_FPS=5
PREVIEW_MAX_WIDTH=640
# Optional JSON array of extra browser origins; same-origin is always supported.
PREVIEW_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]

# Periodic desired-state repair after a missed notification
RECONCILE_INTERVAL_SECONDS=30

# Person tracking: processed-frame aging, not capture frames or wall-clock time
PERSON_TRACK_MAX_AGE=25
TRACK_MATCH_IOU=0.5
TRACK_ACTIVATION_CONFIDENCE=0.25

# API defaults for zone rules; nullable per-camera overrides inherit these values.
LOITERING_THRESHOLD_SECONDS=10
ZONE_ENTER_DWELL_SECONDS=0.25
ZONE_EXIT_GRACE_SECONDS=0.5
EVENT_COOLDOWN_SECONDS=3
# Worker: minimum confirmed observations and severity of generated zone-entry events.
EVENT_MIN_TRACK_HITS=3
SEVERITY_LOITERING=warning
SEVERITY_ZONE_ENTER=critical

# M8: worker writes / API reads and cleans the SAME private local directory.
SNAPSHOT_PATH=data/snapshots
# API default; nullable camera override can enable/disable snapshots individually.
SNAPSHOT_ENABLED=true
SNAPSHOT_RETENTION_DAYS=30
SNAPSHOT_CLEANUP_INTERVAL_SECONDS=3600

# M9 worker: normalized signed distance to directed line P1→P2.
LINE_HYSTERESIS=0.01
SEVERITY_LINE_CROSS=warning
